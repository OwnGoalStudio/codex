# Where Codex's source comes from. This repository is not a fork: the tree is
# fetched at the pinned ref and the patches in patches/ are applied on top.
#
# UPSTREAM_REF is a full commit sha on purpose. patches/ is context-sensitive,
# so a moving branch turns "the build broke" into "which of the last twenty
# upstream commits broke it". Bump it deliberately:
#
#     make bump-upstream REF=<sha>
#
UPSTREAM_REPO=https://github.com/openai/codex.git
UPSTREAM_REF=f277e313f1ce6f5ea02792fb48e1093a5540ecfc

# Cargo package that produces the CLI, the binary Cargo names, and the name
# it ships as on device. The workspace lives under codex-rs/.
CARGO_DIR=codex-rs
CARGO_PACKAGE=codex-cli
CARGO_BIN=codex
PROGRAM=codex

# rust-toolchain.toml in upstream pins this. build-ios.sh installs it.
RUST_TOOLCHAIN=1.95.0

# Deployment target. 15.0 is the floor of the jailbreaks this is packaged for.
MIN_IOS=15.0
ARCH=arm64
